// ─── Generador ──────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

// ─── Fuente de datos (Supabase PostgreSQL) ────────────────────────
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Modelo: Servicio ────────────────────────────────────────────
// Catálogo de servicios que ofrece el negocio de maquillaje.
model Service {
  id          String  @id @default(uuid())
  name        String
  description String
  price       Float
  duration    Int     // duración en minutos
  imageUrl    String?

  // Relación 1-a-muchos con citas
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

// ─── Modelo: Clienta ─────────────────────────────────────────────
// Catálogo de clientas guardadas de antemano, para elegirlas al agendar
// una cita en vez de escribir sus datos a mano cada vez. Sin relación a
// Appointment: cada cita conserva su propia copia de nombre/teléfono/
// correo al momento de agendarla (igual que antes de este modelo).
model Client {
  id    String  @id @default(uuid())
  name  String
  phone String?
  email String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// ─── Modelo: Cita ────────────────────────────────────────────────
// Representa una cita agendada por un cliente.
// status: PENDIENTE | CONFIRMADA | CANCELADA | COMPLETADA
model Appointment {
  id          String   @id @default(uuid())
  clientName  String
  clientEmail String
  clientPhone String
  date        DateTime // fecha del turno (sin hora — la hora va en timeSlot)
  timeSlot    String   // ej. "10:00", "14:30"
  notes       String?
  status      String   @default("PENDIENTE")
  amountEarned Float?  // lo que ganó en esta cita, capturado al completarla

  // Relación con el servicio contratado
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}
